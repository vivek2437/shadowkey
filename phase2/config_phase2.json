{
  "database": {
    "path": "shadowkey_data.db"
  },
  "export": {
    "json_dir": "exports/json",
    "csv_dir": "exports/csv"
  },
  "ml": {
    "model_path": "models/behavioral_auth.pkl",
    "scaler_path": "models/feature_scaler.pkl",
    "contamination": 0.05,
    "min_training_sessions": 5,
    "prediction_interval": 50,
    "n_estimators": 100
  },
  "visualization": {
    "update_interval": 10,
    "rolling_window_size": 100,
    "chart_refresh_rate": 1.0
  },
  "session": {
    "timeout_seconds": 300,
    "min_keystrokes": 20
  },
  "features": {
    "top_digraphs_count": 10,
    "speed_window_size": 30
  }
}
